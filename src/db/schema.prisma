// ============================================================================
// Namasthetu Property Intelligence Operating System — Master Database Schema
// Database: PostgreSQL 17 Aurora with PostGIS & pgvector extensions
// Spec Reference: HYC-SCO-2026-3841 (Docs 01 to 07)
// ============================================================================

generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
  engineType      = "client"
  runtime         = "bun"
}

datasource db {
  provider   = "postgresql"
  // NOTE: pgvector was declared here as `pgvector`, which is not a valid
  // Postgres extension name (the extension installs as `vector`), and the
  // postgis/postgis:17-3.5 image in docker-compose.yml does not ship it at all.
  // `prisma db push` therefore failed with "extension pgvector is not
  // available", which made the db-migration service — and so the whole
  // `docker compose up` bring-up — fail. No column in this schema uses a
  // vector type yet, so the declaration was pure cost.
  // When the SSE embedding column lands (doc 06), re-add it as `vector` AND
  // move to a base image that ships both PostGIS and pgvector.
  extensions = [postgis]
}

// ============================================================================
// 1. STATE MACHINE ENUMS (CLOSED GRAPH GOVERNANCE - DOC 05)
// ============================================================================

/// 13-State Property Lifecycle
enum PropertyStatus {
  DRAFT                 // Initial wizard draft
  SUBMITTED             // Submitted by owner for processing
  VERIFYING             // KYC and ownership deed OCR underway
  INSPECTION_SCHEDULED  // Inspector dispatched / scheduled
  INSPECTED             // 80-point on-ground inspection completed
  CAPTURED              // 3D scan & spatial mesh uploaded
  READY                 // PIP fully generated and verified
  ACTIVE_LISTING        // Published and publicly discoverable
  PAUSED                // Temporarily paused by owner
  IN_TRANSACTION        // Offer accepted; escrow hold placed
  TRANSFERRED           // Sub-registrar deed executed; PIP transferred
  OFF_MARKET            // Retained non-discoverable historical record
  ARCHIVED              // Hidden from discovery, preserved for audit
}

/// 6-State User KYC Lifecycle
enum UserKycStatus {
  SIGNED_UP             // Mobile & Email set
  PHONE_VERIFIED        // OTP successfully validated
  BASIC_KYC             // DigiLocker Aadhaar & PAN tokenized
  ENHANCED_OWNER        // Ownership deed cross-matched and verified
  SUSPENDED             // Flagged for fraud or policy violation
  DELETED               // DPDPA 2023 purge request executed
}

/// 8-State Ownership & Identity Verification Flow
enum VerificationStatus {
  NOT_STARTED
  KYC_INITIATED
  IDENTITY_IN_CHECK
  IDENTITY_VERIFIED
  DOCS_IN_REVIEW
  VERIFIED              // AI confidence > 85% or Ops approved
  MANUAL_QUEUE          // Low AI confidence routed to Ops triage
  REJECTED              // Validation failed / fraudulent
}

/// 6-State Listing Lifecycle
enum ListingStatus {
  DRAFT
  PENDING_APPROVAL      // Awaiting LQA (Listing Quality Auditor) check
  ACTIVE                // LQA score >= 72; visible to buyers
  PAUSED
  EXPIRED               // Inactive for 90 days
  CLOSED                // Deal completed or owner closed
}

/// 7-State Field Inspection Lifecycle
enum InspectionStatus {
  SCHEDULED             // Field engineer assigned
  IN_PROGRESS           // Inspector checked in on-site
  SUBMITTED             // 80-pt checklist completed
  QA_PENDING            // Photos and scan uploaded for QA
  QA_PASSED             // AI anti-spoof + Ops QA approved
  QA_FAILED             // Quality dispute; re-inspection queued
  CANCELLED
}

/// 7-State Legal Document Lifecycle (S3 WORM Vault)
enum DocumentStatus {
  UPLOADED              // Encrypted upload received
  EXTRACTING            // OCR and AI parsing running (DEE)
  EXTRACTED             // Entities (survey #, owner, liens) parsed
  VALIDATED             // Cross-matched with government records
  REVIEWING             // Low confidence match; manual queue
  REJECTED
  EXPIRED               // Expiration date passed (e.g., NOC, tax)
}

/// 8-State Transaction & Escrow Lifecycle
enum TransactionStatus {
  INITIATED             // Buyer signals structured interest
  NEGOTIATING           // Offer and counter-offer loop
  AGREED                // Commercial terms accepted
  ESCROW_HELD           // Token payment locked in Razorpay Escrow
  EXECUTING             // Lease/Sale agreement e-Signed
  COMPLETED             // Registration complete; escrow funds released
  DISPUTED              // Dispute raised by either party
  ABORTED               // Transaction cancelled; escrow refunded
}

/// 5-State Listing Quality Auditor (LQA) Scoring Flow
enum LqaStatus {
  QUEUED
  SCORING
  SCORED
  APPROVED              // Score >= 72
  REJECTED              // Score < 72; returns to draft with notes
}

