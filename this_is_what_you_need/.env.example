# ============================================================================
# Namasthetu Embedded AI Platform — Environment Variables
# Location: this_is_what_you_need/.env.example
# Spec Reference: HYC-SCO-2026-3841 (§12 Embedded ML / AI)
# ============================================================================

# ----------------------------------------------------------------------------
# 1. AI Gateway & LLM / Embedding Providers (§12.4)
# ----------------------------------------------------------------------------
# Anthropic API Key for Claude 3.5 Sonnet (DEE entity extraction & VIE narrative overlay)
ANTHROPIC_API_KEY=sk-ant-api03-...

# OpenAI API Key for text-embedding-3-small (SSE 1536-d dense embeddings)
OPENAI_API_KEY=sk-proj-...

# AI Gateway URL (Kong / Apollo Router proxy for rate limiting, caching & cost governance)
AI_GATEWAY_URL=http://localhost:8080/v1/ai-gateway

# Default LLM and Embedding Model Names
DEFAULT_LLM_MODEL=claude-3-5-sonnet-20241022
DEFAULT_EMBED_MODEL=text-embedding-3-small


# ----------------------------------------------------------------------------
# 2. Pipeline Confidence & Threshold Governance
# ----------------------------------------------------------------------------
# DEE OCR & Entity extraction confidence threshold (default: 0.85). Below this routes to ops queue.
DEE_CONFIDENCE_THRESHOLD=0.85

# PAM Inspection QA Score threshold (default: 70). Below 70 triggers QA_PENDING review.
PAM_QA_PASS_THRESHOLD=70

# VIE / AVM LightGBM compiled model artifact path (optional: uses calibrated ensemble if absent)
LIGHTGBM_AVM_MODEL_PATH=this_is_what_you_need/vie/models/lightgbm_avm_v1.4.treelite


# ----------------------------------------------------------------------------
# 3. Primary Database & Vector Search (PostgreSQL 17 Aurora + pgvector)
# ----------------------------------------------------------------------------
DATABASE_URL=postgresql://namasthetu_user:namasthetu_pass@localhost:5432/namasthetu_db?schema=public

# Valkey / Redis hot cache for PIP read-path & autocomplete (§2a)
VALKEY_HOST=localhost
VALKEY_PORT=6379
REDIS_URL=redis://localhost:6379/0


# ----------------------------------------------------------------------------
# 4. Storage & Asynchronous SQS Worker Queues (AWS / MinIO)
# ----------------------------------------------------------------------------
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=test_access_key
AWS_SECRET_ACCESS_KEY=test_secret_key

# S3 Buckets for Encrypted Artifacts
S3_BUCKET_INSPECTIONS=namasthetu-inspections-encrypted
S3_BUCKET_LEGAL_DOCS=namasthetu-legal-docs-encrypted
S3_BUCKET_MODELS=namasthetu-mlflow-registry

# KEDA Scaled SQS Queue URLs for Asynchronous Workers
SQS_INSPECTION_PHOTO_UPLOAD_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/namasthetu-pam-uploads
SQS_LEGAL_DOC_INGEST_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/namasthetu-dee-ingest
